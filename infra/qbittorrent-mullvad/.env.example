# cp .env.example .env  &&  chmod 600 .env
# The private key is a credential. Do not commit this file.

# ---- Mullvad WireGuard ------------------------------------------------------
# mullvad.net > account > WireGuard configuration > generate key > download a
# config. From that .conf file:
#   [Interface] PrivateKey  -> WIREGUARD_PRIVATE_KEY
#   [Interface] Address     -> WIREGUARD_ADDRESSES
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.64.0.2/32

# Exit location. City names must match Mullvad's, e.g. Amsterdam, Zurich,
# Stockholm, Frankfurt. Full list:
#   docker run --rm qmcgaw/gluetun:v3 format-servers -mullvad
SERVER_CITIES=Amsterdam

# ---- Local -----------------------------------------------------------------
# Your LAN subnet — without this the WebUI is unreachable from other machines.
#   ip route | grep -v default
LAN_SUBNET=192.168.1.0/24

TZ=Etc/UTC

# Must own the downloads directory:  id -u ; id -g
PUID=1000
PGID=1000

# ZFS dataset from the raidz3 setup.
DOWNLOADS_PATH=/tank/torrents
